# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password

# LLM Configuration
LLM_PROVIDER=ollama

# OLLAMA_BASE_URL: URL where Ollama is running
# - For local Ollama: http://localhost:11434
# - For WSL with Ollama on Windows: http://<WSL_GATEWAY_IP>:11434
#   Get WSL gateway IP with: ip route | grep default | awk '{print $3}'
#   Typically: 172.x.x.1 (e.g., http://172.25.160.1:11434)
# IMPORTANT: Ensure Windows Firewall allows connections from WSL network range
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Embeddings Configuration
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Store Configuration
VECTOR_STORE=pgvector
EMBEDDING_DIM=384

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "https://yourusername.github.io"]
